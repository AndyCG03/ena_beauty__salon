# Google reviews (optional). The reviews section stays hidden until both values are set (after the Business Profile is verified).
# Create the key in Google Cloud > APIs & Services, enable "Places API (New)" and restrict the key to that API.
# Set the values in Vercel > Project > Settings > Environment Variables. Never commit a real .env.
GOOGLE_PLACES_API_KEY=
# Required for Ena: copy the Place ID of the verified profile (avoids matching another salon).
GOOGLE_PLACE_ID=
